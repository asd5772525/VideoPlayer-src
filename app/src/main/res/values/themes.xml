<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#0D0F14</color>
    <color name="accent">#FF5C8A</color>

    <style name="Theme.VPlayer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <!-- 启动画面（androidx.core:core-splashscreen）：等设置读完再进入，见 MainActivity -->
    <style name="Theme.VPlayer.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_fg</item>
        <item name="postSplashScreenTheme">@style/Theme.VPlayer</item>
    </style>

    <style name="Theme.VPlayer.Player">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
